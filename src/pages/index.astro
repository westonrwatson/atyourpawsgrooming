---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import StatsBar from "../components/StatsBar.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ServicesSection from "../components/ServicesSection.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Gallery from "../components/Gallery.astro";
import ClientTestimonials from "../components/ClientTestimonials.astro";
import AboutSection from "../components/AboutSection.astro";
import MeetTheGroomers from "../components/MeetTheGroomers.astro";
import HomeFAQ from "../components/HomeFAQ.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name}>
  <div class="flex min-h-screen flex-col bg-surface">
    <Header />
    <main class="flex-1 bg-surface">
      <Hero />
      <StatsBar />
      <HowItWorks />
      <ServicesSection />
      <BeforeAfter />
      <Gallery />
      <ClientTestimonials />
      <AboutSection />
      <MeetTheGroomers />
      <HomeFAQ />
    </main>
    <Footer />
  </div>
</BaseLayout>

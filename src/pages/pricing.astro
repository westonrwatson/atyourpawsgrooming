---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { pricingIntro, pricingTiers } from "../data/pricing";
---

<BaseLayout
  title={`Pricing | ${site.name}`}
  description={`Mobile dog and cat grooming pricing for ${site.serviceAreaShort}.`}
>
  <div class="flex min-h-screen flex-col bg-surface">
    <Header />
    <main class="flex-1">
      <section class="section-pad bg-surface md:!px-10 md:!py-20">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-3xl text-center">
            <h1 class="section-heading text-ink">Pricing</h1>
            <p class="type-lead mx-auto mt-4 max-w-lead text-ink/90">{pricingIntro}</p>
          </div>

          <ul class="mt-10 grid list-none gap-5 p-0 sm:mt-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
            {
              pricingTiers.map((tier) => (
                <li class="flex">
                  <article class="flex h-full w-full flex-col rounded-2xl border border-ink/10 bg-white px-5 py-6 shadow-[0_6px_24px_rgba(10,22,40,0.06)] sm:rounded-3xl sm:px-6 sm:py-7">
                    <div class="flex items-start justify-between gap-3">
                      <h2 class="type-card-title text-ink">{tier.name}</h2>
                      <p class="type-stat-value shrink-0 text-brand">{tier.startingAt}</p>
                    </div>
                    <p class="type-body mt-2 text-ink/85">{tier.description}</p>
                    <ul class="type-small mt-5 list-disc space-y-2 pl-5 text-ink/85">
                      {tier.includes.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  </article>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "contact" | "outline";
  type?: "button" | "submit";
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className = "",
  external = false,
} = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold transition hover:brightness-105 active:scale-[0.98]";

const variants = {
  primary: "bg-brand text-surface shadow-md uppercase tracking-wide",
  secondary: "bg-brand text-surface shadow-md uppercase tracking-wide",
  contact:
    "bg-brand text-surface px-6 py-2.5 normal-case tracking-normal font-semibold shadow-sm",
  outline:
    "border-2 border-brand bg-transparent text-brand uppercase tracking-wide hover:bg-brand/5",
};

const classes = `${base} ${variants[variant]} ${className}`;
const externalProps = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalProps}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}

---
import { groomers } from "../data/groomers";
---

<section id="team" class="section-pad bg-brand-soft md:!px-10 md:!py-20">
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="section-heading text-ink">Meet the Groomers</h2>
    <p class="type-lead mx-auto mt-4 max-w-lead text-ink/90">
      Calm, skilled hands for every dog and cat. We bring the salon experience to your
      driveway with patience and care.
    </p>

    <ul class="mt-10 grid list-none gap-8 p-0 sm:mt-12 md:grid-cols-2 md:gap-10">
      {
        groomers.map((person) => (
          <li class="flex">
            <figure class="flex w-full flex-col items-center">
              <div class="w-full max-w-sm overflow-hidden rounded-2xl shadow-[0_8px_32px_rgba(10,22,40,0.08)] sm:max-w-none sm:rounded-3xl">
                <img
                  src={person.image}
                  alt={person.imageAlt}
                  class="aspect-[4/5] w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="1000"
                />
              </div>
              <figcaption class="mt-5">
                <p class="type-card-title text-ink">{person.name}</p>
                <p class="type-body mt-1 text-ink/80">{person.title}</p>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { site } from "../data/site";

const steps = [
  {
    title: "Book an Appointment",
    description:
      "Schedule online or call us to pick a time that works for you. We confirm the appointment and note your pet's breed and grooming needs.",
  },
  {
    title: "We Come to You",
    description:
      "Our mobile grooming van comes to your driveway. We bathe, trim, and finish your pet's groom one-on-one, with no crowded salon.",
  },
  {
    title: "A Fresh, Happy Pet",
    description:
      "When the groom is complete, your dog or cat is clean, comfortable, and handed back to you, ready to relax at home.",
  },
];
---

<section id="how-it-works" class="bg-surface px-4 py-14 md:px-10 md:py-20">
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="font-display text-3xl text-ink md:text-4xl lg:text-5xl">
      How It Works
    </h2>
    <p class="font-body mx-auto mt-4 max-w-2xl text-base font-light text-ink/90 md:text-lg">
      Mobile pet grooming in three easy steps, all from the comfort of home.
    </p>

    <div class="mt-12 grid gap-10 text-left md:grid-cols-3 md:gap-8 md:text-center lg:gap-12">
      {
        steps.map((step, index) => (
          <div>
            <p
              class="font-body text-sm font-light uppercase tracking-wide text-ink/70"
            >
              Step {index + 1}
            </p>
            <h3 class="font-display mt-2 text-2xl text-ink md:text-3xl">
              {step.title}
            </h3>
            <p class="font-body mt-4 text-base font-light leading-relaxed text-ink md:mx-auto md:max-w-xs">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>

    <a
      href={site.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-body mt-12 inline-flex rounded-full bg-[#108AAA] px-8 py-3 text-base font-normal text-surface transition hover:bg-[#0d7894]"
    >
      Book Now
    </a>
  </div>
</section>

---
import PhoneIcon from "./PhoneIcon.astro";
import { site } from "../data/site";

const steps = [
  {
    title: "Book an Appointment",
    description:
      "Schedule online or call us to pick a time that works for you. We confirm the appointment and note your pet's breed and grooming needs.",
    icon: "phone" as const,
  },
  {
    title: "We Come to You",
    description:
      "Our mobile grooming van comes to your driveway. We bathe, trim, and finish your pet's groom one-on-one, with no crowded salon.",
    icon: "van" as const,
  },
  {
    title: "A Fresh, Happy Pet",
    description:
      "When the groom is complete, your dog or cat is clean, comfortable, and handed back to you, ready to relax at home.",
    icon: "dog" as const,
  },
];
---

<section id="how-it-works" class="section-pad bg-brand-soft-dark md:!px-10 md:!py-20">
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="section-heading text-ink">How It Works</h2>

    <div class="mt-10 grid gap-8 text-center md:mt-12 md:grid-cols-3 md:gap-8 lg:gap-12">
      {
        steps.map((step) => (
          <div>
            <div
              class="mx-auto flex h-[4.5rem] w-[4.5rem] items-center justify-center"
              aria-hidden="true"
            >
              {
                step.icon === "phone" && <PhoneIcon class="h-14 w-14 text-ink" />
              }
              {
                step.icon === "van" && (
                  <span
                    class="icon-ink-mask icon-ink-mask--logo-van h-[3.25rem] w-[5rem] max-w-full"
                    aria-hidden="true"
                  />
                )
              }
              {
                step.icon === "dog" && (
                  <img
                    src="/images/how-it-works-dog.png"
                    alt=""
                    class="h-[4rem] w-[4rem] object-contain"
                    width="112"
                    height="112"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
            </div>
            <h3 class="type-card-title mt-4 text-ink md:mt-5">{step.title}</h3>
            <p class="type-body mx-auto mt-3 max-w-xs text-ink sm:mt-4">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>

    <a
      href={site.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-body btn-cta mt-10 bg-brand text-surface hover:bg-brand-dark md:mt-12"
    >
      Book Now
    </a>
  </div>
</section>

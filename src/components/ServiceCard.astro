---
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article
  class="flex h-full w-full flex-col overflow-hidden rounded-3xl bg-brand text-center text-surface shadow-[0_8px_24px_rgba(10,22,40,0.12)]"
>
  <img
    src={service.image}
    alt={service.imageAlt}
    class="aspect-[4/3] w-full shrink-0 object-cover"
    style={service.imageObjectPosition
      ? `object-position: ${service.imageObjectPosition}`
      : undefined}
    loading="lazy"
    width="600"
    height="450"
  />
  <div class="flex flex-1 flex-col justify-center px-4 py-4 sm:px-5 sm:py-5 md:px-6 md:py-6">
    <h3 class="type-card-title leading-tight text-surface">{service.title}</h3>
    <p class="type-small mt-2.5 text-surface/95 md:mt-3">
      {service.description}
    </p>
  </div>
</article>

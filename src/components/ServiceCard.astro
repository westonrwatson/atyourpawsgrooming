---
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="overflow-hidden rounded-3xl bg-[#FC6DAB] text-center">
  <img
    src={service.image}
    alt={service.imageAlt}
    class="aspect-[5/4] w-full object-cover"
    style={service.imageObjectPosition
      ? `object-position: ${service.imageObjectPosition}`
      : undefined}
    loading="lazy"
    width="600"
    height="480"
  />
  <div class="px-6 py-6 md:px-7 md:py-7">
    <h3 class="font-display text-2xl leading-tight text-ink md:text-3xl">
      {service.title}
    </h3>
    <p class="font-body mx-auto mt-3 max-w-[16rem] text-sm font-light leading-relaxed text-ink md:max-w-xs md:text-base">
      {service.description}
    </p>
  </div>
</article>

---
import { faqItems } from "../data/faq";
---

<section id="faq" class="section-pad bg-surface md:!px-10 md:!py-20">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] md:items-center md:gap-10 lg:gap-12 xl:gap-16">
    <div class="flex flex-col justify-center text-center md:text-left">
      <h2 class="section-heading text-ink">Frequently Asked Questions</h2>
      <p class="type-lead mx-auto mt-4 max-w-lead text-ink/90 md:mx-0">
        Quick answers about mobile grooming, booking, and what to expect at your home.
      </p>
      <img
        src="/images/home-faq-illustration.png"
        alt="Happy dog and cat in a bubble bath with a rubber duck"
        class="mx-auto mt-8 w-full max-w-sm object-contain md:mx-0 md:max-w-md"
        width="512"
        height="512"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div
      class="home-faq-panel overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-[0_6px_24px_rgba(10,22,40,0.06)] sm:rounded-3xl"
    >
      <ul class="home-faq-list list-none p-0">
        {
          faqItems.map((item, index) => (
            <li class="home-faq-row border-b border-ink/10 last:border-b-0">
              <details class="home-faq-item px-5 py-4 sm:px-6 sm:py-5" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left marker:content-none">
                <span class="type-card-title font-normal text-ink">{item.question}</span>
                <span
                  class="home-faq-chevron flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"
                  aria-hidden="true"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </span>
              </summary>
              <p class="type-body mt-3 text-left text-ink/85">{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .home-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq-item[open] .home-faq-chevron {
    transform: rotate(180deg);
  }

  .home-faq-chevron {
    transition: transform 0.2s ease;
  }
</style>

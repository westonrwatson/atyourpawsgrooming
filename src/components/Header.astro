---
import { site } from "../data/site";
import { mainNavLinks } from "../data/navigation";

const navLinks = mainNavLinks;
---

<header class="sticky top-0 z-50 border-b border-ink/5 bg-surface/95 backdrop-blur-sm">
  <div class="section-pad !py-3 md:!px-10 md:!py-5">
    <div
      class="relative z-[60] mx-auto grid max-w-6xl grid-cols-[1fr_auto] items-center gap-3"
    >
    <a
      href="/"
      class="flex min-w-0 items-center gap-2.5 justify-self-start leading-none text-ink sm:gap-3"
    >
      <img
        src="/images/home-faq-illustration.png"
        alt=""
        class="h-14 w-14 shrink-0 object-contain sm:h-16 sm:w-16 md:h-[4.25rem] md:w-[4.25rem]"
        width="512"
        height="512"
        decoding="async"
      />
      <span class="min-w-0">
        <span class="type-logo-display block">AT YOUR PAWS</span>
        <span class="type-logo-tagline -mt-0.5 block tracking-normal">
          Mobile Pet Grooming
        </span>
      </span>
    </a>

    <div class="hidden items-center justify-end gap-8 lg:flex">
      <nav
        id="main-nav"
        class="main-nav relative flex items-center justify-end gap-8"
        aria-label="Main"
      >
        <span id="nav-underline" class="nav-underline" aria-hidden="true"></span>
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-nav-link
              data-section={link.section}
              data-nav-id={link.navId}
              class:list={[
                "nav-link type-body text-ink",
                link.navId === "home" && "is-active",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brand type-body inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-7 py-2.5"
      >
        Book Appointment
      </a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="menu-toggle relative flex h-11 w-11 shrink-0 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="menu-toggle-bars" aria-hidden="true">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </span>
    </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-[55] flex min-h-dvh flex-col bg-surface lg:hidden"
    aria-hidden="true"
  >
    <nav
      class="mobile-menu-nav flex flex-1 flex-col items-center justify-center gap-8 px-6 pt-20"
      aria-label="Mobile"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-section={link.section}
            data-nav-id={link.navId}
            class="mobile-nav-link nav-link section-heading font-normal text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="mobile-menu-cta shrink-0 px-6 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-4">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brand mobile-nav-link font-body btn-cta !max-w-none"
      >
        Book Appointment
      </a>
    </div>
  </div>
</header>

<style>
  .menu-toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
  }

  .menu-bar {
    display: block;
    height: 2px;
    width: 100%;
    border-radius: 1px;
    background-color: var(--color-ink);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-link {
    opacity: 0;
    transform: translateY(10px);
  }

  .mobile-menu.is-open .mobile-nav-link {
    animation: mobile-nav-in 0.45s ease forwards;
  }

  .mobile-menu.is-open .mobile-menu-nav .mobile-nav-link:nth-child(1) {
    animation-delay: 0.08s;
  }
  .mobile-menu.is-open .mobile-menu-nav .mobile-nav-link:nth-child(2) {
    animation-delay: 0.14s;
  }
  .mobile-menu.is-open .mobile-menu-nav .mobile-nav-link:nth-child(3) {
    animation-delay: 0.2s;
  }
  .mobile-menu.is-open .mobile-menu-nav .mobile-nav-link:nth-child(4) {
    animation-delay: 0.26s;
  }
  .mobile-menu.is-open .mobile-menu-nav .mobile-nav-link:nth-child(5) {
    animation-delay: 0.32s;
  }

  .mobile-menu.is-open .mobile-menu-cta .mobile-nav-link {
    animation-delay: 0.38s;
  }

  @keyframes mobile-nav-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .main-nav .nav-underline {
    position: absolute;
    bottom: -6px;
    left: 0;
    height: 1px;
    width: 0;
    opacity: 0;
    background-color: var(--color-brand);
    pointer-events: none;
    transition: none;
  }

  .main-nav .nav-underline.is-placed {
    opacity: 1;
  }

  .main-nav .nav-underline.is-animated {
    transition:
      left 0.28s ease,
      width 0.28s ease;
  }

  .main-nav .nav-link {
    text-decoration: none;
  }

  .nav-link.is-active {
    color: var(--color-ink);
  }

  @media (max-width: 1023px) {
    .nav-link.is-active {
      text-decoration: underline;
      text-decoration-color: var(--color-brand);
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  function setMenuOpen(open: boolean) {
    menu?.classList.toggle("is-open", open);
    menu?.setAttribute("aria-hidden", String(!open));
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.classList.toggle("overflow-hidden", open);
  }

  toggle?.addEventListener("click", () => {
    const open = !menu?.classList.contains("is-open");
    setMenuOpen(open);
  });

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  const mainNav = document.getElementById("main-nav");
  const navUnderline = document.getElementById("nav-underline");
  const navLinksEls = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );
  const desktopNavLinks = Array.from(
    mainNav?.querySelectorAll<HTMLAnchorElement>("[data-nav-link]") ?? [],
  );

  const spySections = ["home", "services", "about"] as const;
  const isHomePage =
    window.location.pathname === "/" ||
    window.location.pathname.endsWith("/index.html");
  let activeNavId = "home";
  /** Holds clicked nav during smooth scroll so spy does not flash intermediate sections. */
  let lockedNavId: string | null = null;
  let scrollUnlockTimer: ReturnType<typeof setTimeout> | undefined;

  function linkForNavId(navId: string) {
    return (
      navLinksEls.find((link) => link.dataset.navId === navId) ??
      navLinksEls.find((link) => link.dataset.section === navId)
    );
  }

  function moveUnderline(link: HTMLAnchorElement, animate = false) {
    if (!mainNav || !navUnderline || !window.matchMedia("(min-width: 1024px)").matches) {
      return;
    }

    navUnderline.classList.toggle("is-animated", animate);

    const navRect = mainNav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    navUnderline.style.width = `${linkRect.width}px`;
    navUnderline.style.left = `${linkRect.left - navRect.left}px`;
    navUnderline.classList.add("is-placed");
  }

  function setActiveNav(navId: string, animate = false) {
    activeNavId = navId;

    navLinksEls.forEach((link) => {
      link.classList.toggle("is-active", link.dataset.navId === navId);
    });

    const desktopLink = desktopNavLinks.find(
      (link) => link.dataset.navId === navId,
    );
    if (desktopLink) {
      moveUnderline(desktopLink, animate);
    }
  }

  function activeNavIdFromScroll() {
    const offset = (document.querySelector("header")?.offsetHeight ?? 0) + 96;
    const y = window.scrollY + offset;
    let section = spySections[0];

    for (const id of spySections) {
      const el = document.getElementById(id);
      if (el && el.offsetTop <= y) {
        section = id;
      }
    }

    return section;
  }

  function updateFromScroll(animate = false) {
    if (!isHomePage || lockedNavId) return;
    setActiveNav(activeNavIdFromScroll(), animate);
  }

  function navIdFromHash() {
    const id = window.location.hash.replace("#", "");
    if (spySections.includes(id as (typeof spySections)[number])) return id;
    return null;
  }

  function initNavFromPage() {
    const path = window.location.pathname.replace(/\/$/, "") || "/";

    if (path === "/privacy" || path === "/terms") {
      navLinksEls.forEach((link) => link.classList.remove("is-active"));
      navUnderline?.classList.remove("is-placed", "is-animated");
      return;
    }

    if (path === "/pricing") {
      setActiveNav("prices", false);
      return;
    }

    if (path === "/gallery") {
      setActiveNav("gallery", false);
      return;
    }

    if (!isHomePage) {
      setActiveNav("home", false);
      return;
    }

    const navId = navIdFromHash() ?? activeNavIdFromScroll();
    setActiveNav(navId, false);
  }

  function scheduleScrollUnlock() {
    if (!lockedNavId) return;
    if (scrollUnlockTimer) clearTimeout(scrollUnlockTimer);
    scrollUnlockTimer = window.setTimeout(() => {
      lockedNavId = null;
      updateFromScroll();
    }, 200);
  }

  navLinksEls.forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href") ?? "";
      const navId = link.dataset.navId ?? "home";
      const isSamePageHash =
        isHomePage && (href.startsWith("#") || href.startsWith("/#"));

      if (!isSamePageHash) {
        return;
      }

      lockedNavId = navId;
      setActiveNav(navId, true);
      scheduleScrollUnlock();
    });
  });

  if (isHomePage) {
    window.addEventListener(
      "scroll",
      () => {
        if (lockedNavId) {
          scheduleScrollUnlock();
          return;
        }
        updateFromScroll();
      },
      { passive: true },
    );

    if ("onscrollend" in window) {
      window.addEventListener("scrollend", () => {
        if (!lockedNavId) return;
        if (scrollUnlockTimer) clearTimeout(scrollUnlockTimer);
        lockedNavId = null;
        updateFromScroll();
      });
    }
  }
  window.addEventListener("resize", () => {
    const activeLink = linkForNavId(activeNavId);
    if (activeLink && desktopNavLinks.includes(activeLink)) {
      moveUnderline(activeLink, false);
    }
  });

  window.addEventListener("load", () => initNavFromPage());

  initNavFromPage();
  requestAnimationFrame(() => initNavFromPage());
</script>

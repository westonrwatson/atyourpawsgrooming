---
import { homeServices } from "../data/services";
import { site } from "../data/site";
import ServiceCard from "./ServiceCard.astro";
---

<section id="services" class="section-pad bg-white md:!px-10 md:!py-20">
  <div class="mx-auto max-w-6xl">
    <div class="text-center">
      <h2 class="section-heading text-ink">Our Services</h2>
      <p class="type-lead mx-auto mt-4 max-w-lead text-ink">
        Professional grooming for dogs and cats at your door, so your pet stays calm
        and you never have to leave home.
      </p>
    </div>

    <ul class="mt-10 grid list-none grid-cols-1 gap-5 p-0 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8">
      {
        homeServices.map((service) => (
          <li class="flex">
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <a href="/pricing" class="btn-brand font-body btn-cta">
        See Pricing
      </a>
    </div>
  </div>
</section>

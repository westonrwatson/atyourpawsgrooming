---
import { site } from "../data/site";
---

<section id="about" class="section-pad bg-brand-soft md:!px-10 md:!py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12">
    <div class="order-2 text-center md:order-1 md:text-left">
      <h2 class="section-heading text-ink">About Us</h2>
      <p class="type-lead mt-5 text-ink sm:mt-6">
        {site.name} brings full-service grooming to your driveway across California's
        Central Valley. We built our mobile salon so pets get calm, one-on-one care and
        families skip the stress of a busy grooming shop.
      </p>
      <p class="type-lead mt-4 text-ink">
        Every visit is tailored to your pet, from nervous cats to high-energy dogs. Our
        team focuses on safe handling, clear communication, and results you can see and
        feel when your best friend comes back to you.
      </p>
      <p class="type-lead mt-4 text-ink">
        Serving {site.serviceAreaShort}.
      </p>
    </div>

    <div class="order-1 md:order-2">
      <img
        src="/images/hero.jpg"
        alt="Groomer caring for a pet inside the mobile grooming van"
        class="mx-auto aspect-[4/3] w-full max-w-md rounded-2xl object-cover object-center shadow-lg sm:max-w-none sm:rounded-3xl md:aspect-square"
        loading="lazy"
        width="1024"
        height="683"
      />
    </div>
  </div>
</section>

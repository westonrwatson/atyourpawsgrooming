---
import { site } from "../data/site";
---

<section id="home" class="section-pad bg-surface md:!px-10 md:!py-16">
  <div
    class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12"
  >
    <div class="order-2 text-center md:order-1 md:text-left">
      <h1 class="section-heading text-ink">
        Expert Grooming for Dogs & Cats
      </h1>
      <p class="type-lead mx-auto mt-5 max-w-lead text-ink/90 md:mx-0 md:mt-6">
        Stress-free, convenient, and professional care every visit.
        <span class="mt-2 block">
          Serving {site.serviceAreaShort}.
        </span>
      </p>
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brand font-body btn-cta mx-auto !mt-7 md:mx-0 md:!mt-8"
      >
        Book Appointment
      </a>
    </div>

    <div class="order-1 md:order-2">
      <img
        src="/images/hero.jpg"
        alt="Groomer caring for a dog inside a mobile grooming van"
        class="aspect-[4/3] w-full max-h-[280px] rounded-2xl object-cover object-center sm:max-h-none sm:rounded-3xl md:aspect-square md:min-h-[420px]"
        width="1024"
        height="683"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

---
const stats = [
  { value: "5", star: true, label: ["Google", "Reviews"] },
  { value: "500+", label: ["Clients", "Served"] },
  { value: "15+", label: ["Cities", "Served"] },
];
---

<section class="bg-brand-soft py-5 md:py-7" aria-label="Highlights">
  <div class="section-pad mx-auto max-w-6xl !py-0 md:!px-10">
    <div class="grid grid-cols-3 divide-x divide-brand/25 sm:hidden">
      {
        stats.map((stat) => (
          <div class="flex flex-col items-center px-1 py-1 text-center">
            <p
              class="type-stat-value inline-flex max-w-full items-center text-brand"
              {...(stat.star ? { "aria-label": `${stat.value} stars` } : {})}
            >
              <span>{stat.value}</span>
              {
                stat.star && (
                  <span class="font-body ml-0.5 text-[0.65em] font-normal leading-none text-brand">
                    ★
                  </span>
                )
              }
            </p>
            <div class="type-caption mt-2 leading-tight text-brand">
              <span class="block">{stat.label[0]}</span>
              <span class="block">{stat.label[1]}</span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hidden sm:flex sm:flex-row sm:items-center sm:justify-center">
      {
        stats.map((stat, index) => (
          <div class="flex flex-row items-center">
            {
              index > 0 && (
                <div
                  class="mx-8 hidden h-12 w-px shrink-0 self-center bg-brand/25 sm:block md:mx-12 lg:mx-16"
                  aria-hidden="true"
                />
              )
            }
            <div class="inline-grid grid-cols-[auto_auto] items-center gap-x-3 px-4 sm:px-6 md:gap-x-4 lg:px-8">
              <p
                class="type-stat-value relative top-1 inline-flex items-center text-brand md:top-1.5"
                {...(stat.star ? { "aria-label": `${stat.value} stars` } : {})}
              >
                <span>{stat.value}</span>
                {
                  stat.star && (
                    <span class="font-body ml-0.5 text-[0.7em] font-normal leading-none text-brand">
                      ★
                    </span>
                  )
                }
              </p>
              <div
                class="type-small flex flex-col justify-center text-left leading-[1.2] text-brand"
              >
                <span>{stat.label[0]}</span>
                <span>{stat.label[1]}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

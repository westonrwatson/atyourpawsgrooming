---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "center" | "left";
  light?: boolean;
}

const {
  eyebrow,
  title,
  description,
  align = "center",
  light = false,
} = Astro.props;

const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
const titleColor = light ? "text-surface" : "text-ink";
const bodyColor = light ? "text-surface/90" : "text-ink/70";
const eyebrowColor = light ? "text-brand-light" : "text-brand";
---

<div class:list={["max-w-lead", alignClass]}>
  {
    eyebrow && (
      <p
        class:list={[
          "mb-2 text-sm font-semibold uppercase tracking-widest",
          eyebrowColor,
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2 class:list={["font-display text-3xl font-bold md:text-4xl", titleColor]}>
    {title}
  </h2>
  {
    description && (
      <p class:list={["mt-4 text-base leading-relaxed", bodyColor]}>
        {description}
      </p>
    )
  }
</div>

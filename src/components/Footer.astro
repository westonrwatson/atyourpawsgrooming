---
import PreFooterCta from "./PreFooterCta.astro";
import PhoneIcon from "./PhoneIcon.astro";
import { site } from "../data/site";
import { footerNavLinks, legalLinks } from "../data/navigation";

const socialLinks = [
  { href: site.social.facebook, label: "Facebook" },
  { href: site.social.instagram, label: "Instagram" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.x, label: "X" },
];
---

<PreFooterCta />

<footer class="w-full bg-brand text-surface">
  <div class="section-pad !py-6 sm:!py-8 md:!px-10 lg:!py-10">
    <div class="mx-auto max-w-6xl">
      <div
        class="flex flex-col items-center gap-8 text-center lg:grid lg:grid-cols-[auto_minmax(17rem,1.5fr)_minmax(0,0.8fr)_minmax(0,0.8fr)] lg:items-start lg:gap-x-10 lg:text-left xl:gap-x-14"
      >
      <a
        href="/"
        class="flex min-w-0 items-center justify-center gap-2.5 leading-none text-surface sm:gap-3 lg:hidden"
      >
        <span
          class="icon-surface-mask icon-surface-mask--logo-van h-12 w-[4.75rem] shrink-0 sm:h-14 sm:w-[5.5rem] md:h-16 md:w-[6.25rem]"
          aria-hidden="true"
        />
        <span class="min-w-0 text-left">
          <span class="type-logo-display block">AT YOUR PAWS</span>
          <span class="type-logo-tagline -mt-0.5 block tracking-normal text-surface/95">
            Mobile Pet Grooming
          </span>
        </span>
      </a>

      <div class="footer-brand-block hidden w-full min-w-0 shrink-0 lg:block lg:w-auto">
        <div class="flex items-center justify-start gap-2 sm:gap-2.5">
          <span class="type-footer-brand leading-none">AT</span>
          <img
            src="/images/logo.png"
            alt=""
            class="logo-on-brand relative -top-1 h-9 w-auto shrink-0 sm:h-10 lg:-top-2 lg:h-[3.25rem] xl:h-[3.75rem]"
            width="120"
            height="48"
            decoding="async"
          />
        </div>
        <p class="type-footer-brand mt-0.5 leading-[0.95]">
          YOUR<br />PAWS
        </p>
        <p class="type-logo-tagline mt-1.5 tracking-wide text-surface/95 lg:mt-1">
          Mobile Pet Grooming
        </p>
      </div>

      <div
        class="footer-contact flex w-full min-w-0 flex-col items-center gap-6 border-y border-surface/25 py-6 lg:w-full lg:items-start lg:justify-start lg:border-y-0 lg:py-0"
      >
        <ul class="type-footer-text w-full max-w-sm space-y-3 text-center lg:max-w-none lg:text-left">
          <li class="flex items-center justify-center gap-2.5 lg:justify-start">
            <PhoneIcon class="h-5 w-5 shrink-0 text-surface" />
            <a href={site.phoneHref} class="hover:opacity-80">{site.phone}</a>
          </li>
          <li class="flex items-center justify-center gap-2.5 lg:justify-start">
            <svg
              class="h-5 w-5 shrink-0 text-surface"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
              <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
            </svg>
            <a href={`mailto:${site.email}`} class="whitespace-nowrap hover:opacity-80">{site.email}</a>
          </li>
          <li class="flex items-center justify-center gap-2.5 lg:justify-start">
            <svg
              class="h-5 w-5 shrink-0 text-surface"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{site.hours}</span>
          </li>
        </ul>
        <div
          class="flex w-full max-w-sm flex-col items-center gap-4 text-center lg:max-w-none lg:items-start lg:text-left"
        >
          <p class="type-footer-text max-w-sm leading-snug lg:max-w-none">
            <span class="block lg:whitespace-nowrap">
              Mobile grooming at your doorstep
            </span>
            <span class="block">across California's Central Valley.</span>
          </p>
          <a
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-body btn-cta !mt-0 !max-w-none bg-surface text-brand hover:bg-white"
          >
            Book Now
          </a>
        </div>
      </div>

      <div
        class="grid w-full max-w-md grid-cols-2 gap-x-8 sm:max-w-sm sm:gap-x-12 lg:contents"
      >
        <div class="min-w-0 text-center lg:text-left">
          <p class="type-footer-heading">Nav</p>
          <ul class="type-footer-text mt-2 space-y-2">
            {
              footerNavLinks.map((link) => (
                <li>
                  <a href={link.href} class="hover:opacity-80">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="min-w-0 text-center lg:text-left">
          <p class="type-footer-heading">Socials</p>
          <ul class="type-footer-text mt-2 space-y-2">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:opacity-80"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      </div>

      <hr class="mt-8 border-surface/25 lg:mt-10" />

      <div
        class="flex flex-col items-center gap-2 pt-3 text-center sm:flex-row sm:items-end sm:justify-between sm:text-left"
      >
      <p class="type-caption leading-snug">
        <span class="block lg:inline">© {new Date().getFullYear()} {site.name}.</span>{" "}
        <span class="block lg:inline">All rights reserved.</span>
      </p>
      <div class="relative flex justify-center overflow-visible sm:shrink-0 sm:justify-end">
        <img
          src="/images/footer-dog.png"
          alt=""
          aria-hidden="true"
          width="150"
          height="150"
          decoding="async"
          class="footer-dog-walk pointer-events-none absolute -top-[4.5rem] left-0 h-[50px] w-[50px] sm:-top-8 md:-top-12 lg:-top-8 [image-rendering:pixelated]"
        />
        <nav
          class="type-caption flex flex-nowrap items-center justify-center gap-x-4 sm:justify-end"
          aria-label="Legal"
        >
        {
          legalLinks.map((link) => (
            <a href={link.href} class="hover:opacity-80">
              {link.label}
            </a>
          ))
        }
        </nav>
      </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-dog-walk {
    transform: translateY(-50%) translateX(0) scaleX(-1);
    transform-origin: center center;
    animation: footer-dog-walk 14s ease-in-out infinite;
  }

  @keyframes footer-dog-walk {
    /* Start flipped, long walk left */
    0%,
    100% {
      transform: translateY(-50%) translateX(0) scaleX(-1);
    }
    46% {
      transform: translateY(-50%) translateX(-150px) scaleX(-1);
    }
    /* Flip and walk back right */
    48% {
      transform: translateY(-50%) translateX(-150px) scaleX(1);
    }
    94% {
      transform: translateY(-50%) translateX(0) scaleX(1);
    }
    96% {
      transform: translateY(-50%) translateX(0) scaleX(-1);
    }
  }

  @media (max-width: 639px) {
    @keyframes footer-dog-walk {
      0%,
      100% {
        transform: translateY(-50%) translateX(0) scaleX(-1);
      }
      46% {
        transform: translateY(-50%) translateX(-90px) scaleX(-1);
      }
      48% {
        transform: translateY(-50%) translateX(-90px) scaleX(1);
      }
      94% {
        transform: translateY(-50%) translateX(0) scaleX(1);
      }
      96% {
        transform: translateY(-50%) translateX(0) scaleX(-1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-dog-walk {
      animation: none;
      transform: translateY(-50%);
    }
  }
</style>

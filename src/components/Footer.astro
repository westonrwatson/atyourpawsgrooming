---
import { site } from "../data/site";

const navLinks = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#faq", label: "FAQ" },
];

const legalLinks = [
  { href: "#", label: "Privacy Policy" },
  { href: "#", label: "Terms of Service" },
];

const socialLinks = [
  { href: site.social.facebook, label: "Facebook" },
  { href: site.social.instagram, label: "Instagram" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.x, label: "X" },
];
---

<footer class="bg-surface px-4 pb-5 pt-4 md:px-10 md:pb-6">
  <div class="mx-auto max-w-6xl rounded-3xl bg-[#F9A03F] px-6 pt-10 text-ink md:px-10 md:pt-12">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-8">
      <div class="lg:col-span-3">
        <p class="font-display text-5xl leading-[0.95] md:text-6xl lg:text-7xl">
          At Your<br />Paws
        </p>
        <p
          class="font-body -mt-0.5 whitespace-nowrap text-sm font-light uppercase leading-none tracking-wide md:text-base"
        >
          Mobile Pet Grooming
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-5">
        <div>
          <p class="font-body text-sm font-bold">Nav</p>
          <ul class="font-body mt-4 space-y-2.5 text-sm font-light">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="hover:opacity-80">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="font-body text-sm font-bold">Legal</p>
          <ul class="font-body mt-4 space-y-2.5 text-sm font-light">
            {
              legalLinks.map((link) => (
                <li>
                  <a href={link.href} class="hover:opacity-80">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="font-body text-sm font-bold">Socials</p>
          <ul class="font-body mt-4 space-y-2.5 text-sm font-light">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:opacity-80"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:col-span-4">
        <p class="font-body max-w-sm text-sm font-light leading-relaxed md:text-base">
          Safe, gentle mobile grooming at your doorstep across California's Central
          Valley.
        </p>
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body mt-6 inline-flex rounded-full bg-surface px-8 py-3 text-sm font-normal text-ink transition hover:bg-surface/90"
        >
          Book Now
        </a>
      </div>
    </div>

    <hr class="mt-8 border-ink/25 md:mt-10" />

    <p class="font-body pb-6 pt-3 text-center text-xs font-light md:pb-7 md:pt-4">
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</footer>

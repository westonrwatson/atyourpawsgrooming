---
import { homeTestimonials } from "../data/testimonials";
---

<section
  id="testimonials"
  class="relative overflow-hidden section-pad bg-brand-soft-dark md:!px-10 md:!py-20"
>
  <div
    class="testimonials-paw-pattern pointer-events-none absolute inset-0 opacity-[0.14] mix-blend-multiply"
    aria-hidden="true"
  />
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="section-heading text-ink">What Our Clients Say</h2>
      <p class="type-lead mt-4 text-ink/85">
        Trusted by pet parents across the Central Valley.
      </p>
    </div>

    <ul class="mt-10 grid list-none gap-5 p-0 sm:mt-12 sm:gap-6 md:grid-cols-3 md:gap-6">
      {
        homeTestimonials.map((item) => (
          <li class="flex">
            <blockquote
              class="flex h-full w-full flex-col rounded-2xl border border-ink/10 bg-white px-5 py-6 text-center shadow-[0_6px_24px_rgba(40,38,44,0.06)] sm:rounded-3xl sm:px-6 sm:py-7"
            >
              <div
                class="flex justify-center gap-0.5 text-brand"
                aria-hidden="true"
              >
                {
                  Array.from({ length: 5 }).map(() => (
                    <span class="font-body text-sm leading-none">★</span>
                  ))
                }
              </div>
              <p class="type-body mt-4 flex-1 text-ink">
                &ldquo;{item.quote}&rdquo;
              </p>
              <footer class="font-body mt-5 border-t border-ink/10 pt-4">
                <cite class="not-italic">
                  <span class="type-small block font-normal text-ink">{item.author}</span>
                  {
                    item.pet && (
                      <span class="type-caption mt-1 block text-ink/70">
                        {item.pet}
                      </span>
                    )
                  }
                </cite>
              </footer>
            </blockquote>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials-paw-pattern {
    --pattern-tile: 175px;
    --pattern-nudge-x: 40px;
    --pattern-nudge-y: -28px;
    background-image: url("/pattern.png"), url("/pattern.png");
    background-repeat: repeat, repeat;
    background-size: var(--pattern-tile) var(--pattern-tile);
    /* Second layer shifted half a tile for a staggered grid */
    background-position:
      var(--pattern-nudge-x) var(--pattern-nudge-y),
      calc(var(--pattern-tile) / 2 + var(--pattern-nudge-x))
        calc(var(--pattern-tile) / 2 + var(--pattern-nudge-y));
  }
</style>

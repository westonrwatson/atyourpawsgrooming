---
import { site } from "../data/site";
---

<section
  class="section-pad border-t border-ink/10 bg-surface md:!px-10 md:!py-16 lg:!py-20"
  aria-labelledby="pre-footer-cta-heading"
>
  <div class="mx-auto max-w-6xl">
    <div
      class="rounded-2xl border border-surface/10 bg-navy px-6 py-10 text-center shadow-[0_8px_32px_rgba(6,16,40,0.35)] sm:rounded-3xl sm:px-10 sm:py-12 md:px-14 md:py-14"
    >
      <h2 id="pre-footer-cta-heading" class="section-heading text-surface">
        Ready for a stress-free groom?
      </h2>
      <p class="type-lead mx-auto mt-4 max-w-lead text-surface/90">
        Book online in a few clicks, or call us and we will help you schedule a visit at your home.
      </p>

      <div
        class="pre-footer-cta-actions mx-auto mt-8 flex w-full max-w-md flex-col items-center gap-3 sm:mt-10 sm:max-w-none sm:flex-row sm:flex-wrap sm:justify-center sm:gap-4"
      >
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brand font-body btn-cta sm:!max-w-[14rem]"
        >
          Book Appointment
        </a>
        <a
          href={site.phoneHref}
          class="font-body btn-cta border-2 border-surface/50 bg-transparent text-surface hover:bg-surface/10 sm:!max-w-[14rem]"
        >
          Call {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pre-footer-cta-actions .btn-cta {
    width: min(100%, 20rem);
  }

  @media (min-width: 640px) {
    .pre-footer-cta-actions .btn-cta {
      width: auto;
    }
  }
</style>

---
import PawIcon from "./PawIcon.astro";
import WaveTop from "./WaveTop.astro";
import { site } from "../data/site";
---

<section id="contact" class="contact-pattern px-4 pb-20 md:px-8">
  <WaveTop fill="#f2f4f3" />
  <div class="mx-auto max-w-3xl pt-10 md:pt-14">
    <form
      class="rounded-3xl bg-white p-6 shadow-xl md:p-10"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
    >
      <h2 class="font-display text-4xl font-bold text-blue-dark">Get In Touch</h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold text-blue-dark">
          First Name
          <input
            type="text"
            name="firstName"
            required
            class="mt-1 w-full rounded-xl border border-blue-dark/15 px-4 py-3 font-normal outline-none focus:border-blue-primary"
          />
        </label>
        <label class="block text-sm font-semibold text-blue-dark">
          Last Name
          <input
            type="text"
            name="lastName"
            required
            class="mt-1 w-full rounded-xl border border-blue-dark/15 px-4 py-3 font-normal outline-none focus:border-blue-primary"
          />
        </label>
      </div>

      <label class="mt-4 block text-sm font-semibold text-blue-dark">
        E-mail
        <input
          type="email"
          name="email"
          required
          class="mt-1 w-full rounded-xl border border-blue-dark/15 px-4 py-3 font-normal outline-none focus:border-blue-primary"
        />
      </label>

      <label class="mt-4 block text-sm font-semibold text-blue-dark">
        Message
        <textarea
          name="message"
          rows="4"
          required
          class="mt-1 w-full resize-y rounded-xl border border-blue-dark/15 px-4 py-3 font-normal outline-none focus:border-blue-primary"
        ></textarea>
      </label>

      <label class="mt-4 block text-sm font-semibold text-blue-dark">
        Subject
        <select
          name="subject"
          class="mt-1 w-full rounded-xl border border-blue-dark/15 bg-white px-4 py-3 font-normal outline-none focus:border-blue-primary"
        >
          <option>Book an appointment</option>
          <option>General question</option>
          <option>Service area</option>
        </select>
      </label>

      <label class="mt-6 flex items-start gap-3 text-sm text-blue-dark/80">
        <input type="checkbox" name="terms" required class="mt-1" />
        <span>I agree to the terms and conditions.</span>
      </label>

      <div class="mt-6 flex justify-end">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-brand px-8 py-3 text-sm font-normal uppercase tracking-wide text-surface shadow-md"
        >
          Send
          <PawIcon class="h-4 w-4" />
        </button>
      </div>
    </form>
  </div>
</section>
